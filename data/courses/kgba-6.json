   "fees": {
    "weekday": "비회원 210,000원 (우대회원 55,000 / 정회원 70,000 / 주중회원 75,000, 회원제 18홀·세금포함)",
    "weekend": "비회원 250,000원 (우대회원 60,000 / 정회원 75,000)",
